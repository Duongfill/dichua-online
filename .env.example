# Sao chép thành .env (cùng thư mục) rồi sửa. Server tự đọc file .env khi khởi động.

# ---- Voice (LiveKit) ----
# Chạy local bằng `docker compose up -d` (hoặc livekit-server --dev): dùng nguyên 3 dòng dưới.
# Dùng LiveKit Cloud: lấy URL dạng wss://<project>.livekit.cloud và API key/secret trong trang Settings → Keys.
# Bỏ trống → game vẫn chạy, chỉ tắt trò chuyện bằng giọng nói.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- Server ----
# PORT=3180
# CORS_ORIGIN=https://chua.example.com
